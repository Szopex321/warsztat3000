<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:warsztat3000.ViewModels"
             x:Class="warsztat3000.Views.PojazdyView"
             x:DataType="vm:PojazdyViewModel"
             Background="#0B0A10"
             Foreground="White">

    <Grid RowDefinitions="Auto, *" Margin="20">
        
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <TextBlock Text="Baza Pojazdów" FontSize="24" FontWeight="Bold" Foreground="#00FF00" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="✪ dodaj nowy pojazd" Background="#00FF00" Foreground="Black" FontWeight="Bold" Padding="15,8" CornerRadius="4"/>
        </Grid>
        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding ListaPojazdow}" 
                 SelectedItem="{Binding WybranyPojazd}" 
                 Background="Transparent" 
                 BorderThickness="0">
            
            <ListBox.Styles>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#15141E" CornerRadius="8" Padding="20" Margin="0,0,0,10" BorderBrush="#2A2A35" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto, *, *, Auto">
                            
                            <Border Grid.Column="0" Width="60" Height="40" Background="#2A2A35" CornerRadius="4" Margin="0,0,20,0">
                                <TextBlock Text="🚗" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Marka}" FontSize="18" FontWeight="Bold" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Model}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RokProdukcji, StringFormat='Rok produkcji: {0}'}" Foreground="Gray" FontSize="14" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NrRejestracyjny}" FontSize="18" Foreground="#00FF00" FontWeight="Bold"/>
                                <TextBlock Text="{Binding VIN, StringFormat='VIN: {0}'}" Foreground="Gray" FontSize="14" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="WŁAŚCICIEL" FontSize="10" Foreground="Gray" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Klient.Nazwisko}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Klient.Imie}" FontSize="14" Foreground="LightGray" HorizontalAlignment="Right"/>
                            </StackPanel>
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>