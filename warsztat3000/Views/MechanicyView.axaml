<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:warsztat3000.Models"
             xmlns:vm="using:warsztat3000.ViewModels"
             x:Class="warsztat3000.Views.MechanicyView"
             x:Name="Root"
             x:DataType="vm:MechanicyViewModel"
             Background="#0B0A10"
             Foreground="White">

    <Grid RowDefinitions="Auto, *" Margin="20">
        
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <TextBlock Text="Nasi Mechanicy" FontSize="24" FontWeight="Bold" Foreground="#00FF00" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Dodaj mechanika" Command="{Binding DodajMechanikaCommand}" Background="#00FF00" Foreground="Black" FontWeight="Bold" Padding="15,8" CornerRadius="4"/>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding ListaMechanikow}" Background="Transparent" BorderThickness="0">
            <ListBox.Styles>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:Mechanik">
                    <Border Background="#15141E" CornerRadius="8" Padding="20" Margin="0,0,0,10" BorderBrush="#2A2A35" BorderThickness="1">
                        <Grid ColumnDefinitions="*, *, Auto, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Imie}" FontSize="18" FontWeight="Bold" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Nazwisko}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Specjalizacja}" Foreground="#00FF00" FontSize="14" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="TELEFON" FontSize="10" Foreground="Gray"/>
                                <TextBlock Text="{Binding Telefon}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="STATUS" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CzyAktywny, StringFormat='Aktywny: {0}'}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <Button Content="Edytuj"
                                        Command="{Binding #Root.DataContext.EdytujMechanikaCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        Foreground="LightGray"
                                        BorderBrush="#2A2A35"
                                        Margin="0,0,0,6"
                                        Padding="10,4"/>
                                <Button Content="Aktywuj / wyłącz"
                                        Command="{Binding #Root.DataContext.DezaktywujMechanikaCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        Foreground="#FFDD77"
                                        BorderBrush="#2A2A35"
                                        Padding="10,4"/>
                            </StackPanel>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>