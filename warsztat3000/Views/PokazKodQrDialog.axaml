<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="warsztat3000.Views.PokazKodQrDialog"
        Title="KOD QR NAPRAWY"
        Width="460" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0B0A10"
        Foreground="White"
        CanResize="False">

    <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="KOD QR NAPRAWY" FontSize="18" FontWeight="Bold" Foreground="#00FF00" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <Border Width="230" Height="230" Background="White" CornerRadius="8" Margin="0,0,0,20" Padding="10">
            <Image x:Name="QrImage" Stretch="Uniform"/>
        </Border>

        <TextBlock Text="Link do statusu:" Foreground="Gray" HorizontalAlignment="Center" FontSize="12"/>
        <Grid ColumnDefinitions="*, Auto" Width="380" Margin="0,5,0,15">
            <TextBox x:Name="LinkText" IsReadOnly="True" Background="#15141E" Foreground="White" BorderBrush="#2A2A35" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="Kopiuj" Click="KopiujLink_Click" Background="#00FF00" Foreground="Black" FontWeight="Bold" Padding="12,6"/>
        </Grid>

        <TextBlock Text="Token naprawy:" Foreground="Gray" HorizontalAlignment="Center" FontSize="12"/>
        <TextBlock x:Name="TokenText" Text="ABC-123" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,5,0,20"/>

        <Button Content="Zamknij" Click="Zamknij_Click" Background="Transparent" Foreground="LightGray" BorderBrush="#2A2A35" BorderThickness="1" HorizontalAlignment="Center" Padding="20,8"/>
    </StackPanel>
</Window>
