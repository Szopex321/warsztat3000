<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="warsztat3000.Views.DodajNapraweDialog"
        Title="DODAJ NAPRAWĘ"
        Width="500" Height="450"
        WindowStartupLocation="CenterOwner"
        Background="#0B0A10"
        Foreground="White"
        CanResize="False">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        <TextBlock Text="DODAJ NAPRAWĘ" FontSize="18" FontWeight="Bold" Foreground="#00FF00" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" x:Name="BladText" Foreground="#FF5555" Margin="0,0,0,10" IsVisible="False"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Wybrany pojazd:" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
            <TextBlock x:Name="PojazdText" Text="Brak wybranego pojazdu" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <TextBlock Text="Mechanik prowadzący:" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
            <ComboBox x:Name="MechanikCombo" PlaceholderText="Wybierz mechanika" Background="#15141E" BorderBrush="#2A2A35" Foreground="White" HorizontalAlignment="Stretch" Margin="0,0,0,20"/>

            <TextBlock Text="Planowany koniec:" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
            <TextBox x:Name="PlanowanyKoniecBox" PlaceholderText="dd.mm.rrrr" Background="#15141E" BorderBrush="#2A2A35" Foreground="White" HorizontalAlignment="Stretch" Margin="0,0,0,20"/>

            <TextBlock Text="Uwagi techniczne przy przyjęciu:" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
            <TextBox x:Name="UwagiBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" Background="#15141E" BorderBrush="#2A2A35" Foreground="White"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Click="Anuluj_Click" Background="Transparent" Foreground="LightGray" BorderBrush="#2A2A35" BorderThickness="1" Margin="0,0,10,0" Padding="15,8"/>
            <Button x:Name="DodajNapraweButton" Content="Dodaj Naprawę" Click="Rozpocznij_Click" Background="#00FF00" Foreground="Black" FontWeight="Bold" Padding="15,8"/>
        </StackPanel>
    </Grid>
</Window>
