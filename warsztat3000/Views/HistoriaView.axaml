<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:warsztat3000.ViewModels"
             x:Class="warsztat3000.Views.HistoriaView"
             x:DataType="vm:HistoriaViewModel"
             Background="#0B0A10"
             Foreground="White">

    <Grid RowDefinitions="Auto, *" Margin="20">
        
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Historia Napraw" FontSize="24" FontWeight="Bold" Foreground="#00FF00" VerticalAlignment="Center"/>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding ZakonczoneNaprawy}" Background="Transparent" BorderThickness="0">
            <ListBox.Styles>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#15141E" CornerRadius="8" Padding="20" Margin="0,0,0,10" BorderBrush="#2A2A35" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto, *, *, Auto">
                            
                            <StackPanel Grid.Column="0" Margin="0,0,30,0" VerticalAlignment="Center">
                                <TextBlock Text="ZAKOŃCZONO" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding RzeczywistyKoniec, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Pojazd.NrRejestracyjny}" FontSize="18" Foreground="#00FF00" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Pojazd.Marka}" Foreground="White" FontSize="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Pojazd.Model}" Foreground="White" FontSize="14"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Pojazd.Klient.Nazwisko, StringFormat='Właściciel: {0}'}" FontSize="14"/>
                                <TextBlock Text="{Binding MechanikProwadzacy.Nazwisko, StringFormat='Mechanik: {0}'}" FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="3" Background="#00FF00" CornerRadius="4" Padding="15,5" VerticalAlignment="Center">
                                <TextBlock Text="ZAKOŃCZONE" Foreground="Black" FontWeight="Bold" FontSize="12"/>
                            </Border>
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>