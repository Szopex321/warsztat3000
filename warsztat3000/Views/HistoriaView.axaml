<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:warsztat3000.ViewModels"
             x:Class="warsztat3000.Views.HistoriaView"
             x:DataType="vm:HistoriaViewModel"
             Background="#0B0A10"
             Foreground="White">

    <Grid RowDefinitions="Auto, *" Margin="20">
        
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Historia Napraw" FontSize="24" FontWeight="Bold" Foreground="#00FF00" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="330, *">
            <Border Grid.Column="0" Background="#15141E" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <Grid RowDefinitions="Auto, Auto, *">
                    <TextBlock Text="AUTA Z HISTORIĄ" FontSize="12" Foreground="Gray" Margin="0,0,0,15"/>
                    <TextBox Grid.Row="1"
                             PlaceholderText="szukaj po marce lub właścicielu"
                             Text="{Binding TekstWyszukiwania}"
                             Background="#20202B"
                             Foreground="White"
                             BorderBrush="#2A2A35"
                             Margin="0,0,0,15"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding PojazdyZHistoria}"
                             SelectedItem="{Binding WybranyPojazd, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:HistoriaPojazduViewModel">
                                <Border Background="#20202B" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#2A2A35" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Rejestracja}" FontSize="17" Foreground="#00FF00" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding MarkaModel}" FontSize="13" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Wlasciciel}" FontSize="12" Foreground="Gray" Margin="0,3,0,0"/>
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding LiczbaWizytOpis}" FontSize="12" Foreground="#FFE600"/>
                                            <TextBlock Grid.Column="1" Text="{Binding OstatniaWizytaOpis}" FontSize="11" Foreground="Gray"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#15141E" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="WIZYTY WYBRANEGO AUTA" FontSize="12" Foreground="Gray"/>
                        <TextBlock Text="{Binding NaglowekWybranegoPojazdu}" FontSize="20" FontWeight="Bold" Foreground="#00FF00" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding WizytyWybranegoPojazdu}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:WizytaHistoriiViewModel">
                                    <Border Background="#20202B" CornerRadius="8" Padding="15" Margin="0,0,0,12" BorderBrush="#2A2A35" BorderThickness="1">
                                        <Grid RowDefinitions="Auto, Auto, Auto">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DataOpis}" FontSize="18" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding StatusOpis}" FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="CENA" FontSize="10" Foreground="Gray" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding CenaOpis}" FontSize="18" Foreground="#00FF00" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <Button Content="Kosztorys"
                                                            Command="{Binding PokazKosztorysCommand}"
                                                            Background="#00FF00"
                                                            Foreground="Black"
                                                            FontWeight="Bold"
                                                            Padding="12,6"
                                                            Margin="0,8,0,0"
                                                            HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,14,0,0">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="KTO ROBIŁ" FontSize="10" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding MechanikOpis}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                                <TextBlock Text="CO BYŁO ROBIONE" FontSize="10" Foreground="Gray"/>
                                                <TextBlock Text="{Binding CzynnosciOpis}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>